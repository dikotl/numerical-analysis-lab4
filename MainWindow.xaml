<Window x:Class="Spline.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Spline"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="450"
        Width="800">
    <Grid>
        <Canvas
            x:Name="DrawCanvas"
            Background="#FAFAFA"
            MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
            MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
            MouseMove="Canvas_MouseMove"
            MouseRightButtonDown="Canvas_MouseRightButtonDown"/>

        <StackPanel
            Margin="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="#CCFFFFFF">
            <TextBlock
                Text="Usage:"
                FontWeight="Bold"
                FontSize="14"/>

            <TextBlock
                Text=" - LMB: Add\Drag point"/>

            <TextBlock
                Text=" - RMB: Remove point"/>

            <TextBlock
                Text=" - Lagrange's Polinomial"
                Foreground="#1E90FF"
                FontWeight="Bold"
                Margin="0,10,0,0"/>

            <TextBlock
                Text=" - Spline"
                Foreground="#FF8C00"
                FontWeight="Bold"/>

            <TextBlock
                Text=" - Difference"
                Foreground="#DC143C"
                FontWeight="Bold"/>

            <CheckBox
                x:Name="IsClosedSpline"
                Content="Closed spline"
                Checked="IsClosedSpline_CheckedChanged"
                Unchecked="IsClosedSpline_CheckedChanged"
                Margin="0,10,0,0"/>

            <Button
                Content="Copy formulas to clipboard"
                Margin="0,15,0,0"
                Padding="10,5"
                Click="BtnCopyFormulas_Click"
                Cursor="Hand"
                Background="#4CAF50"
                Foreground="White"
                FontWeight="Bold"
                BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
